msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: zh_Hans\n"
"MIME-Version: 1.0\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "Add"
msgstr "添加"

msgid "Assign fixed IP addresses to DHCP clients and optionally hand out a different gateway and DNS servers to each of them."
msgstr "为 DHCP 客户端分配固定 IP，并可为每台设备单独下发网关和 DNS。"

msgid "Auto"
msgstr "自动"

msgid "Clients that currently hold a DHCP lease from this device. Use \"Make static\" to turn a lease into a static lease."
msgstr "当前从本机获取到 DHCP 地址的终端。点击“转为静态”即可把动态租约转为静态分配。"

msgid "Remark"
msgstr "备注"

msgid "DHCP Clients"
msgstr "DHCP 终端列表"

msgid "DHCP Static Leases"
msgstr "DHCP 静态分配"


msgid "Default"
msgstr "默认"

msgid "Dynamic"
msgstr "动态"

msgid "Edit"
msgstr "编辑"

msgid "Edit static lease"
msgstr "编辑静态分配"

msgid "Enable"
msgstr "状态"

msgid "Gateway"
msgstr "网关"

msgid "Generated automatically when a gateway or DNS server is set."
msgstr "设置网关或 DNS 后自动生成。"

msgid "Host-specific lease time, e.g. <code>5m</code>, <code>3h</code>, <code>7d</code> or <code>infinite</code>."
msgstr "单独的租期，例如 <code>5m</code>、<code>3h</code>、<code>7d</code> 或 <code>infinite</code>。"

msgid "Grant access to DHCP static leases"
msgstr "允许访问 DHCP 静态分配"

msgid "Hostname"
msgstr "主机名称"

msgid "Client IP"
msgstr "终端 IP"

msgid "Ignore (do not answer)"
msgstr "忽略（不响应该终端）"

msgid "Bound interface"
msgstr "绑定接口"

msgid "Lease time"
msgstr "租期"

msgid "Lease time remaining"
msgstr "剩余租期"

msgid "Leave both DNS fields empty to use the default DNS servers of the DHCP server."
msgstr "首选、备选 DNS 都留空时使用 DHCP 服务器默认的 DNS。"

msgid "Leave empty to use the default gateway of the DHCP server."
msgstr "留空则使用 DHCP 服务器默认的网关。"

msgid "Client MAC"
msgstr "终端 MAC"

msgid "Make static"
msgstr "转为静态"

msgid "One of hostname or MAC address must be specified!"
msgstr "主机名称和 MAC 地址至少要填一个！"

msgid "Determined automatically from the IP address: a static lease only applies on the interface whose subnet contains it."
msgstr "根据终端 IP 自动判断：静态分配只在 IP 所属网段的接口上生效。"

msgid "Please fill in the primary DNS first"
msgstr "请先填写首选 DNS"

msgid "Primary DNS"
msgstr "首选 DNS"

msgid "Secondary DNS"
msgstr "备选 DNS"

msgid "Static"
msgstr "静态"

msgid "Static Leases"
msgstr "静态分配列表"

msgid "Tag"
msgstr "标签"

msgid "The IP address %h is already used by another static lease"
msgstr "IP 地址 %h 已被其他静态分配使用"

msgid "The MAC address %h is already used by another static lease"
msgstr "MAC 地址 %h 已被其他静态分配使用"

msgid "The required dnsmasq tag (<code>networkid</code>) is created and removed automatically. Everything is stored as standard OpenWrt configuration in <code>/etc/config/dhcp</code>, so the entries stay valid without this application."
msgstr "所需的 dnsmasq 标签（<code>networkid</code>）会自动创建和删除。所有内容都以 OpenWrt 原生格式保存在 <code>/etc/config/dhcp</code>，卸载本插件后配置依然有效。"

msgid "There are no active leases"
msgstr "没有活动的租约"

msgid "Type"
msgstr "类型"

msgid "expired"
msgstr "已过期"

msgid "%d to add, %d to update, %d skipped."
msgstr "新增 %d 条，更新 %d 条，跳过 %d 条。"

msgid "Action"
msgstr "操作"

msgid "Activate"
msgstr "启用"

msgid "Activated"
msgstr "已启用"

msgid "Cancel"
msgstr "取消"

msgid "DNS"
msgstr "DNS"

msgid "Deactivate"
msgstr "停用"

msgid "Deactivated"
msgstr "已停用"

msgid "Delete %d selected static lease(s)?"
msgstr "确定删除选中的 %d 条静态分配？"

msgid "Delete"
msgstr "删除"

msgid "Export"
msgstr "导出"

msgid "IP address already used by %s"
msgstr "IP 已被 %s 使用"

msgid "Import finished: %d added, %d updated, %d skipped. Click \"Save & Apply\" to activate the changes."
msgstr "导入完成：新增 %d 条，更新 %d 条，跳过 %d 条。点击“保存并应用”后生效。"

msgid "Import"
msgstr "导入"

msgid "Line %d skipped: %s"
msgstr "第 %d 行已跳过：%s"

msgid "Merge into current data"
msgstr "合并到当前数据"

msgid "Merge: entries with the same MAC address are updated and new ones are added. Without merging, all current static leases are replaced by the file."
msgstr "合并：MAC 相同的条目会被更新，其余新增。不合并：先删除当前全部静态分配，再导入文件内容。"

msgid "New"
msgstr "新增"

msgid "Not merging: all %d current static leases will be deleted first."
msgstr "未勾选合并：将先删除当前全部 %d 条静态分配。"

msgid "Please select at least one entry first"
msgstr "请先勾选至少一条"

msgid "Select a CSV file exported from iKuai (DHCP server → DHCP static allocation → Export)."
msgstr "选择从爱快导出的 CSV 文件（DHCP 服务端 → DHCP 静态分配 → 导出）。"

msgid "Select all"
msgstr "全选"

msgid "Skip"
msgstr "跳过"

msgid "Status"
msgstr "状态"

msgid "The file is empty"
msgstr "文件是空的"

msgid "Unable to read the file"
msgstr "无法读取文件"

msgid "Unrecognized file: expected an iKuai CSV export with the columns ip_addr and mac"
msgstr "无法识别的文件：需要爱快导出的 CSV（包含 ip_addr 和 mac 列）"

msgid "Update"
msgstr "更新"

msgid "duplicate IP address in file (line %d)"
msgstr "文件内 IP 重复（第 %d 行）"

msgid "duplicate MAC address in file (line %d)"
msgstr "文件内 MAC 重复（第 %d 行）"

msgid "invalid IP address"
msgstr "IP 地址无效"

msgid "invalid MAC address"
msgstr "MAC 地址无效"

msgid "invalid gateway or DNS address"
msgstr "网关或 DNS 地址无效"
